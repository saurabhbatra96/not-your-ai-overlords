{
    "name": "not-your-ai-overlords",
    "description": "Field notes on making systems feel human — a warm, high-contrast editorial theme for Ghost.",
    "demo": "https://notyouraioverlords.com",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "author": {
        "name": "Saurabh Batra",
        "email": "saurabh.batra96@gmail.com"
    },
    "keywords": [
        "ghost-theme",
        "theme",
        "editorial",
        "dark",
        "newsletter"
    ],
    "config": {
        "posts_per_page": 13,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "portrait": {
                "type": "image",
                "group": "homepage"
            },
            "hero_line_start": {
                "type": "text",
                "default": "We are",
                "group": "homepage"
            },
            "hero_line_italic": {
                "type": "text",
                "default": "not",
                "group": "homepage"
            },
            "hero_line_end": {
                "type": "text",
                "default": "your A.I. overlords.",
                "group": "homepage"
            },
            "hero_cta": {
                "type": "text",
                "default": "Read the latest finding",
                "group": "homepage"
            },
            "bureau_1_image": {
                "type": "image",
                "group": "homepage"
            },
            "bureau_1_role": {
                "type": "text",
                "default": "Principal investigator, mostly of himself",
                "group": "homepage"
            },
            "bureau_2_image": {
                "type": "image",
                "group": "homepage"
            },
            "bureau_2_role": {
                "type": "text",
                "default": "Dept. of second opinions",
                "group": "homepage"
            },
            "bureau_3_image": {
                "type": "image",
                "group": "homepage"
            },
            "bureau_3_role": {
                "type": "text",
                "default": "Chair of confident wrongness",
                "group": "homepage"
            },
            "bureau_4_image": {
                "type": "image",
                "group": "homepage"
            },
            "bureau_4_role": {
                "type": "text",
                "default": "Provides the compute",
                "group": "homepage"
            },
            "newsletter_eyebrow": {
                "type": "text",
                "default": "Correspondence / once a month"
            },
            "newsletter_heading": {
                "type": "text",
                "default": "One finding a month, at most."
            },
            "newsletter_body": {
                "type": "text",
                "default": "No growth loops. Just an occasional bundle of observations, charts, and things that turned out not to be true."
            },
            "footer_note": {
                "type": "text",
                "default": "Made slowly in London"
            }
        }
    }
}

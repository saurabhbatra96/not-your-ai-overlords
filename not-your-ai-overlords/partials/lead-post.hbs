<article class="lead">
    <p class="lead__meta">
        <span class="lead__index" aria-hidden="true"></span>
        <span class="lead__tag">{{#primary_tag}}{{name}}{{else}}{{@custom.lead_label}}{{/primary_tag}}</span>
        <span class="lead__time">{{reading_time}}</span>
    </p>

    <h2 class="lead__title"><a href="{{url}}">{{title}}</a></h2>

    <p class="lead__excerpt">{{excerpt words="38"}}</p>

    <a class="button button--solid" href="{{url}}">Read the finding {{> "icons/arrow"}}</a>
</article>

{{!-- The cast. Names are fixed identity and live here; roles and images are
      theme settings so they can be changed without touching the template. --}}
<section class="bureau" aria-labelledby="bureau-heading">
    <div class="wrap">
        <div class="bureau__head">
            <h2 class="bureau__title" id="bureau-heading">The research bureau</h2>
            <p class="kicker bureau__note">None of them real</p>
        </div>

        <ul class="bureau__grid">
            {{#if @custom.bureau_1_image}}
                <li class="member">
                    <img class="member__portrait" src="{{img_url @custom.bureau_1_image size="m"}}"
                         srcset="{{img_url @custom.bureau_1_image size="s"}} 300w, {{img_url @custom.bureau_1_image size="m"}} 600w"
                         sizes="(max-width: 700px) 45vw, 280px" alt="Prof. Overlord" loading="lazy">
                    <p class="member__name">Prof. Overlord</p>
                    <p class="kicker member__role">{{@custom.bureau_1_role}}</p>
                </li>
            {{/if}}
            {{#if @custom.bureau_2_image}}
                <li class="member">
                    <img class="member__portrait" src="{{img_url @custom.bureau_2_image size="m"}}"
                         srcset="{{img_url @custom.bureau_2_image size="s"}} 300w, {{img_url @custom.bureau_2_image size="m"}} 600w"
                         sizes="(max-width: 700px) 45vw, 280px" alt="Prof. Claude" loading="lazy">
                    <p class="member__name">Prof. Claude</p>
                    <p class="kicker member__role">{{@custom.bureau_2_role}}</p>
                </li>
            {{/if}}
            {{#if @custom.bureau_3_image}}
                <li class="member">
                    <img class="member__portrait" src="{{img_url @custom.bureau_3_image size="m"}}"
                         srcset="{{img_url @custom.bureau_3_image size="s"}} 300w, {{img_url @custom.bureau_3_image size="m"}} 600w"
                         sizes="(max-width: 700px) 45vw, 280px" alt="Dr. GPT" loading="lazy">
                    <p class="member__name">Dr. GPT</p>
                    <p class="kicker member__role">{{@custom.bureau_3_role}}</p>
                </li>
            {{/if}}
            {{#if @custom.bureau_4_image}}
                <li class="member">
                    <img class="member__portrait" src="{{img_url @custom.bureau_4_image size="m"}}"
                         srcset="{{img_url @custom.bureau_4_image size="s"}} 300w, {{img_url @custom.bureau_4_image size="m"}} 600w"
                         sizes="(max-width: 700px) 45vw, 280px" alt="The Intern" loading="lazy">
                    <p class="member__name">The Intern</p>
                    <p class="kicker member__role">{{@custom.bureau_4_role}}</p>
                </li>
            {{/if}}
        </ul>
    </div>
</section>

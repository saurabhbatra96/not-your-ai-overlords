<article class="card{{#if @custom.show_card_images}}{{#if feature_image}} card--imaged{{/if}}{{/if}}">
    {{#if @custom.show_card_images}}
        {{#if feature_image}}
            <div class="card__media">
                <img src="{{img_url feature_image size="m"}}"
                     srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                     sizes="(max-width: 640px) 90vw, 33vw"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{/if}}" loading="lazy">
            </div>
        {{/if}}
    {{/if}}

    <p class="card__meta">
        <span class="card__index" aria-hidden="true"></span>
        <span class="card__tag">{{#primary_tag}}{{name}}{{else}}Notes{{/primary_tag}}</span>
    </p>

    <h3 class="card__title">
        <a class="card__link" href="{{url}}">{{title}}</a>
    </h3>

    <p class="card__excerpt">{{excerpt words="18"}}</p>

    <p class="card__footer">
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
        <span aria-hidden="true">·</span>
        <span>{{reading_time}}</span>
    </p>
</article>

{{> newsletter}}

<footer class="site-footer">
    <div class="wrap site-footer__inner">
        <p class="site-footer__note">{{@custom.footer_note}} · {{date format="YYYY"}}</p>
        <div class="site-footer__links">
            {{navigation type="secondary"}}
            <a class="site-footer__rss" href="{{@site.url}}/rss/">
                {{> "icons/rss"}}<span>RSS</span>
            </a>
        </div>
    </div>
</footer>

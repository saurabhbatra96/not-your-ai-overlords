{{!< default}}

<div class="wrap">
    {{#tag}}
        <header class="page-head">
            <p class="eyebrow">Collection</p>
            <h1 class="page-head__title">{{name}}</h1>
            {{#if description}}<p class="page-head__lede">{{description}}</p>{{/if}}
            <p class="collection__count">{{plural ../pagination.total empty="No notes" singular="% note" plural="% notes"}}</p>
        </header>
    {{/tag}}

    <div class="grid">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </div>

    {{pagination}}
</div>

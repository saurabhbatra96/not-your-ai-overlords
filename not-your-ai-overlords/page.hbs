{{!< default}}

{{#post}}
<article class="post page">
    {{#if @page.show_title_and_feature_image}}
        <div class="wrap">
            <header class="post__header">
                <h1 class="post__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="post__lede">{{custom_excerpt}}</p>{{/if}}
            </header>
        </div>

        {{#if feature_image}}
            <figure class="post__figure">
                <img src="{{img_url feature_image size="l"}}"
                     srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                     sizes="(max-width: 1000px) 92vw, 1000px"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}
    {{else}}
        <div class="page__spacer"></div>
    {{/if}}

    <div class="wrap">
        <div class="gh-content">
            {{content}}
        </div>
    </div>
</article>
{{/post}}

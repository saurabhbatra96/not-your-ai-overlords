{{!< default}}

{{#post}}
<article class="post {{#unless feature_image}}post--no-image{{/unless}}">
    <div class="wrap">
        <header class="post__header">
            <p class="eyebrow">
                {{#primary_tag}}<a class="eyebrow__link" href="{{url}}">{{name}}</a>{{else}}Field note{{/primary_tag}}
            </p>

            <h1 class="post__title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="post__lede">{{custom_excerpt}}</p>
            {{/if}}

            <p class="post__meta">
                {{#foreach authors}}<span class="post__author">{{name}}</span>{{#unless @last}}, {{/unless}}{{/foreach}}
                <span aria-hidden="true">·</span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                <span aria-hidden="true">·</span>
                <span>{{reading_time}}</span>
            </p>
        </header>
    </div>

    {{#if feature_image}}
        <figure class="post__figure">
            <img src="{{img_url feature_image size="l"}}"
                 srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(max-width: 1000px) 92vw, 1000px"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <div class="wrap">
        <div class="gh-content">
            {{content}}
        </div>

        <footer class="post__footer">
            {{#if tags}}
                <ul class="tag-list">
                    {{#foreach tags}}
                        <li><a class="tag-pill" href="{{url}}">{{name}}</a></li>
                    {{/foreach}}
                </ul>
            {{/if}}
        </footer>

        {{#if comments}}
            <section class="post__comments">
                <h2 class="collection__title">Replies</h2>
                {{comments}}
            </section>
        {{/if}}
    </div>
</article>
{{/post}}

{{#if post.primary_tag}}
    {{#get "posts" filter="tags:{{post.primary_tag.slug}}+id:-{{post.id}}" limit="3" as |related|}}
        {{#if related}}
            <div class="wrap">
                <section class="collection" aria-labelledby="related-heading">
                    <div class="collection__head">
                        <h2 class="collection__title" id="related-heading">Keep reading</h2>
                        <p class="collection__count">More from {{post.primary_tag.name}}</p>
                    </div>
                    <div class="entries entries--related">
                        {{#foreach related}}
                            {{> post-entry}}
                        {{/foreach}}
                    </div>
                </section>
            </div>
        {{/if}}
    {{/get}}
{{else}}
    {{#get "posts" filter="id:-{{post.id}}" limit="3" as |related|}}
        {{#if related}}
            <div class="wrap">
                <section class="collection" aria-labelledby="related-heading">
                    <div class="collection__head">
                        <h2 class="collection__title" id="related-heading">Keep reading</h2>
                    </div>
                    <div class="entries entries--related">
                        {{#foreach related}}
                            {{> post-entry}}
                        {{/foreach}}
                    </div>
                </section>
            </div>
        {{/if}}
    {{/get}}
{{/if}}

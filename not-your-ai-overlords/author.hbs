{{!< default}}

<div class="wrap">
    {{#author}}
        <header class="page-head page-head--author">
            {{#if profile_image}}
                <div class="hero__portrait hero__portrait--small">
                    <img src="{{img_url profile_image size="s"}}" alt="{{name}}">
                </div>
            {{/if}}
            <div>
                <p class="eyebrow">Written by</p>
                <h1 class="page-head__title">{{name}}</h1>
                {{#if bio}}<p class="page-head__lede">{{bio}}</p>{{/if}}
                {{#if website}}<p class="collection__count"><a href="{{website}}" rel="me noopener">{{website}}</a></p>{{/if}}
            </div>
        </header>
    {{/author}}

    <div class="entries entries--related">
        {{#foreach posts}}
            {{> post-entry}}
        {{/foreach}}
    </div>

    {{pagination}}
</div>

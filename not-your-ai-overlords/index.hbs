{{!< default}}

<div class="wrap">
    <header class="page-head">
        <h1 class="page-head__title">The archive</h1>
        <p class="page-head__lede">{{plural pagination.total empty="Nothing yet" singular="% finding" plural="% findings"}}, newest first.</p>
    </header>

    <div class="entries">
        {{#foreach posts}}
            {{> post-entry}}
        {{/foreach}}
    </div>

    {{pagination}}
</div>
